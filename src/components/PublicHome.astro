---
import type { CollectionEntry } from 'astro:content';
import DayCard from './DayCard.astro';
import { CAT_LABELS, useTranslation } from '../i18n/translations';
import { getDayView } from '../lib/dayView';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  days: CollectionEntry<'days'>[];
}

const { lang, days } = Astro.props;
const tr = useTranslation(lang);

const categories = ['tragedija', 'pokret', 'korupcija', 'policija', 'politika', 'svet'] as const;
const start = new Date('2024-11-01T00:00:00+01:00').getTime();
const dayCount = Math.max(1, Math.round((Date.now() - start) / 86_400_000));
const numberLocale = lang === 'sr' ? 'sr-Latn-RS' : lang;
const featured = days.find((day) => day.data.date === '2024-11-01') ?? days.find((day) => day.data.important) ?? days[0];
const featuredView = featured ? getDayView(featured, lang) : null;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{tr('heroKicker')}</p>
    <h1 id="hero-title">{tr('heroTitle')}</h1>
    <p class="hero-lead">{tr('heroLead')}</p>

    <dl class="stats" aria-label="Ciazzi statistics">
      <div>
        <dt>{tr('statDays')}</dt>
        <dd>{dayCount.toLocaleString(numberLocale)}</dd>
      </div>
      <div>
        <dt>{tr('statLives')}</dt>
        <dd>16</dd>
      </div>
      <div>
        <dt>{tr('statLangs')}</dt>
        <dd>6</dd>
      </div>
    </dl>
  </div>

  {featuredView && (
    <a class="featured" href={featuredView.url}>
      <img
        src={featuredView.thumbnail.src}
        alt={featuredView.thumbnail.alt}
        loading="eager"
        onerror="this.closest('.featured')?.classList.add('image-failed')"
      />
      <div class="featured-shade"></div>
      <div class="featured-body">
        <span class="featured-label">{tr('readMore')}</span>
        <h2>{featuredView.title}</h2>
        <p>{featuredView.lead}</p>
        <span class="featured-date">{featuredView.dateLabel}</span>
      </div>
    </a>
  )}
</section>

<section class="silence-band" aria-label={tr('silence')}>
  <i class="ti ti-clock-hour-11" aria-hidden="true"></i>
  <span>{tr('silence')}</span>
</section>

<section class="archive" aria-labelledby="archive-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">{tr('secTitle')}</p>
      <h2 id="archive-title">{tr('secSub')}</h2>
    </div>
    <span class="archive-count">{days.length.toLocaleString(numberLocale)} / {dayCount.toLocaleString(numberLocale)}</span>
  </div>

  <div class="filters" id="filters" aria-label="Filter by category">
    <button class="chip active" type="button" data-cat="all">{tr('fAll')}</button>
    {categories.map((cat) => (
      <button class="chip" type="button" data-cat={cat}>{CAT_LABELS[lang][cat]}</button>
    ))}
  </div>

  <div class="day-grid" id="grid">
    {days.map((day) => <DayCard day={day} lang={lang} />)}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 0.78fr);
    gap: 28px;
    padding: 38px 0 24px;
    align-items: stretch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 410px;
    padding: 18px 0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(38px, 5.8vw, 64px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }

  .hero-lead {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--text-muted);
    font-size: clamp(17px, 2.2vw, 22px);
    line-height: 1.45;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    width: min(100%, 680px);
    margin: 36px 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(42, 47, 56, 0.10);
  }

  .stats div {
    min-height: 108px;
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    padding: 17px;
    background: rgba(255, 253, 248, 0.82);
  }

  .stats dt {
    color: var(--text-dim);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .stats dd {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(34px, 5vw, 54px);
    line-height: 0.95;
  }

  .featured {
    position: relative;
    min-height: 410px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    isolation: isolate;
  }

  .featured img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transform: scale(1.01);
  }

  .featured.image-failed img {
    display: none;
  }

  .featured.image-failed::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(212,61,50,0.3), rgba(21,23,27,0.8)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 18px);
  }

  .featured-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(16,17,20,0.05), rgba(16,17,20,0.82) 64%, rgba(16,17,20,0.95)),
      linear-gradient(90deg, rgba(16,17,20,0.42), transparent);
  }

  .featured-body {
    position: absolute;
    inset: auto 0 0;
    padding: 26px;
  }

  .featured-label,
  .featured-date {
    display: inline-flex;
    color: #fffdf8;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured-label {
    color: #ffb3ab;
    margin-bottom: 10px;
  }

  .featured h2 {
    max-width: 520px;
    margin: 0;
    color: #fffdf8;
    font-family: var(--font-serif);
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.04;
  }

  .featured p {
    max-width: 560px;
    margin: 14px 0 16px;
    color: rgba(255,253,248,0.82);
    font-size: 15px;
  }

  .silence-band {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    margin: 10px 0 42px;
    padding: 0 18px;
    border-block: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 700;
  }

  .silence-band i {
    color: var(--accent-strong);
    font-size: 24px;
  }

  .archive {
    padding-bottom: 30px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 18px;
  }

  .section-head h2 {
    max-width: 720px;
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.06;
    letter-spacing: 0;
  }

  .archive-count {
    color: var(--text-dim);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 0 0 20px;
  }

  .chip {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgba(255,253,248,0.86);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 13px;
    font-weight: 800;
  }

  .chip:hover,
  .chip.active {
    border-color: rgba(198,41,45,0.5);
    background: var(--accent-soft);
    color: var(--text);
  }

  .day-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 38px;
    }
    .hero-copy,
    .featured {
      min-height: auto;
    }
    .featured {
      aspect-ratio: 16 / 10;
    }
    .day-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero {
      gap: 18px;
      padding-top: 30px;
    }
    h1 {
      font-size: clamp(34px, 11vw, 44px);
      line-height: 1.04;
    }
    .hero-lead {
      font-size: 16px;
    }
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 24px;
    }
    .stats div {
      min-height: 78px;
      padding: 11px;
    }
    .stats dd {
      font-size: 31px;
    }
    .stats dt {
      font-size: 10px;
    }
    .featured {
      aspect-ratio: 4 / 5;
    }
    .featured-body {
      padding: 20px;
    }
    .silence-band {
      align-items: flex-start;
      padding: 16px 0;
      min-height: 0;
    }
    .section-head {
      display: block;
    }
    .archive-count {
      display: inline-block;
      margin-top: 10px;
    }
    .day-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('#grid .day-card');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      const cat = chip.dataset.cat;
      cards.forEach((card) => {
        const cats = card.dataset.cats?.split(',') ?? [];
        card.hidden = Boolean(cat && cat !== 'all' && !cats.includes(cat));
      });
    });
  });
</script>
