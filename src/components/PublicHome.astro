---
import type { CollectionEntry } from 'astro:content';
import DayCard from './DayCard.astro';
import { CAT_LABELS, useTranslation } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  days: CollectionEntry<'days'>[];
}

const { lang, days } = Astro.props;
const tr = useTranslation(lang);

const categories = ['tragedija', 'pokret', 'korupcija', 'policija', 'politika', 'svet'] as const;
const start = new Date('2024-11-01T00:00:00+01:00').getTime();
const dayCount = Math.max(1, Math.round((Date.now() - start) / 86_400_000));
const numberLocale = lang === 'sr' ? 'sr-Latn-RS' : lang;
const collapseVideoSrc = '/media/2024-11-01/pad_nadstresnice.mp4';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{tr('heroKicker')}</p>
    <h1 id="hero-title">{tr('heroTitle')}</h1>
    <p class="hero-lead">{tr('heroLead')}</p>

    <dl class="stats" aria-label="Ciazzi statistics">
      <div>
        <dt>{tr('statDays')}</dt>
        <dd>{dayCount.toLocaleString(numberLocale)}</dd>
      </div>
      <div>
        <dt>{tr('statLives')}</dt>
        <dd>16</dd>
      </div>
      <div>
        <dt>{tr('statStolen')}</dt>
        <dd>15</dd>
      </div>
      <div>
        <dt>{tr('statPeople')}</dt>
        <dd>{(500000).toLocaleString(numberLocale)}</dd>
      </div>
    </dl>

    <section class="movement-chyron" aria-label={tr('movementLabel')}>
      <strong>{tr('movementLabel')}</strong>
      <span>{tr('movementChyron')}</span>
    </section>
  </div>

  <figure class="collapse-video">
    <video
      src={collapseVideoSrc}
      controls
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      aria-label="Snimak pada nadstresnice"
    ></video>
  </figure>
</section>

<section class="name-note" aria-label={tr('aboutName')}>
  <h2>{tr('siteNameTitle')} <span>/ˈtʃat.tsi/</span></h2>
  <p><em>{tr('siteNameNoun')}</em> · {tr('siteNameBody')}</p>
  <p class="name-note-final">{tr('siteNameFinal')}</p>
</section>

<section class="silence-band" aria-label={tr('silence')}>
  <i class="ti ti-clock-hour-11" aria-hidden="true"></i>
  <span>{tr('silence')}</span>
</section>

<section class="archive" aria-labelledby="archive-title">
  <div class="section-head">
    <div>
      <p class="eyebrow">{tr('secTitle')}</p>
      <h2 id="archive-title">{tr('secSub')}</h2>
    </div>
    <span class="archive-count">{days.length.toLocaleString(numberLocale)} / {dayCount.toLocaleString(numberLocale)}</span>
  </div>

  <div class="filters" id="filters" aria-label="Filter by category">
    <button class="chip active" type="button" data-cat="all">{tr('fAll')}</button>
    {categories.map((cat) => (
      <button class="chip" type="button" data-cat={cat}>{CAT_LABELS[lang][cat]}</button>
    ))}
  </div>

  <div class="day-grid" id="grid">
    {days.map((day) => <DayCard day={day} lang={lang} />)}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 0.78fr);
    gap: 28px;
    padding: 38px 0 24px;
    align-items: stretch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 410px;
    padding: 18px 0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(27px, 3.2vw, 38px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .hero-lead {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--text-muted);
    font-size: clamp(15px, 1.2vw, 16px);
    line-height: 1.55;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    width: min(100%, 680px);
    margin: 36px 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(42, 47, 56, 0.10);
  }

  .stats div {
    min-height: 108px;
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    padding: 17px;
    background: rgba(255, 253, 248, 0.82);
  }

  .stats dt {
    color: var(--text-dim);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .stats dd {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(30px, 3.4vw, 36px);
    line-height: 1;
  }

  .collapse-video {
    position: relative;
    min-height: 410px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    margin: 0;
  }

  .collapse-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .movement-chyron {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    width: min(100%, 680px);
    margin: 24px 0 0;
    padding: 14px 0;
    border-block: 1px solid rgba(174, 42, 39, 0.22);
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .movement-chyron strong {
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .name-note {
    width: 100%;
    max-width: none;
    margin: 18px 0 18px;
    padding: 18px 22px;
    border: 1px solid rgba(42, 47, 56, 0.14);
    border-left: 4px solid var(--accent-strong);
    border-radius: var(--radius-lg);
    background: rgba(255, 253, 248, 0.76);
    box-shadow: 0 14px 34px rgba(42, 47, 56, 0.06);
  }

  .name-note h2 {
    margin: 0 0 12px;
    color: var(--text);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0;
  }

  .name-note h2 span {
    margin-left: 8px;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
  }

  .name-note p {
    max-width: 1180px;
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .name-note p + p {
    margin-top: 10px;
  }

  .name-note-final {
    color: var(--text);
    font-style: italic;
  }

  .silence-band {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    margin: 10px 0 42px;
    padding: 0 18px;
    border-block: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 700;
  }

  .silence-band i {
    color: var(--accent-strong);
    font-size: 24px;
  }

  .archive {
    padding-bottom: 30px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 18px;
  }

  .section-head h2 {
    max-width: 720px;
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(21px, 2.3vw, 28px);
    line-height: 1.14;
    letter-spacing: 0;
  }

  .archive-count {
    color: var(--text-dim);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 0 0 20px;
  }

  .chip {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: rgba(255,253,248,0.86);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 13px;
    font-weight: 800;
  }

  .chip:hover,
  .chip.active {
    border-color: rgba(198,41,45,0.5);
    background: var(--accent-soft);
    color: var(--text);
  }

  .day-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 38px;
    }
    .hero-copy,
    .collapse-video {
      min-height: auto;
    }
    .collapse-video {
      aspect-ratio: 16 / 10;
    }
    .day-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero {
      gap: 18px;
      padding-top: 30px;
    }
    h1 {
      font-size: clamp(26px, 7.2vw, 32px);
      line-height: 1.13;
    }
    .hero-lead {
      font-size: 14px;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 24px;
    }
    .stats div {
      min-height: 78px;
      padding: 11px;
    }
    .stats dd {
      font-size: 28px;
    }
    .stats dt {
      font-size: 10px;
    }
    .collapse-video {
      aspect-ratio: 4 / 5;
    }
    .movement-chyron {
      margin-top: 18px;
      padding: 14px 0;
      font-size: 14px;
    }
    .name-note {
      margin: 14px 0 16px;
      padding: 18px 16px;
    }
    .name-note h2 {
      font-size: 19px;
    }
    .name-note h2 span {
      display: block;
      margin: 5px 0 0;
      font-size: 14px;
    }
    .name-note p {
      font-size: 13px;
    }
    .silence-band {
      align-items: flex-start;
      padding: 16px 0;
      min-height: 0;
    }
    .section-head {
      display: block;
    }
    .archive-count {
      display: inline-block;
      margin-top: 10px;
    }
    .day-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('#grid .day-card');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      const cat = chip.dataset.cat;
      cards.forEach((card) => {
        const cats = card.dataset.cats?.split(',') ?? [];
        card.hidden = Boolean(cat && cat !== 'all' && !cats.includes(cat));
      });
    });
  });
</script>
