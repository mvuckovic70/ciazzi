---
import type { CollectionEntry } from 'astro:content';
import { getDayView } from '../lib/dayView';
import type { Lang } from '../i18n/translations';

interface Props {
  day: CollectionEntry<'days'>;
  lang: Lang;
}

const { day, lang } = Astro.props;
const view = getDayView(day, lang);
const primaryCategory = view.categories[0];
---

<a href={view.url} class="day-card" data-cats={view.categories.map((cat) => cat.key).join(',')}>
  <div class="media">
    <img
      src={view.thumbnail.src}
      alt={view.thumbnail.alt}
      loading="lazy"
      onerror="this.closest('.media')?.classList.add('image-failed')"
    />
    <span class="media-type">{view.thumbnail.badge}</span>
  </div>

  <div class="content">
    <div class="meta">
      <time datetime={view.date}>{view.dateLabel}</time>
      {primaryCategory && (
        <span class="tag" style={`background:${primaryCategory.color.bg};color:${primaryCategory.color.text};`}>
          {primaryCategory.label}
        </span>
      )}
    </div>

    <h3>{view.title}</h3>
    <p>{view.lead}</p>
  </div>
</a>

<style>
  .day-card {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: rgba(255, 253, 248, 0.92);
    box-shadow: 0 16px 42px rgba(33, 38, 46, 0.07);
    color: #fffdf8;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .day-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--surface-muted);
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04);
    transition: transform 240ms ease;
  }

  .media.image-failed img {
    display: none;
  }

  .media.image-failed::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(212,61,50,0.26), rgba(29,32,38,0.94)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.045) 0 1px, transparent 1px 16px);
  }

  .day-card:hover .media img {
    transform: scale(1.035);
  }

  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(16,17,20,0.72));
  }

  .media-type {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: rgba(16,17,20,0.76);
    color: var(--text);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  time {
    color: var(--text-dim);
    font-size: 12px;
    font-weight: 800;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 650;
    line-height: 1.14;
    letter-spacing: 0;
  }

  p {
    margin: 12px 0 0;
    color: var(--text-muted);
    font-size: 13.5px;
    line-height: 1.56;
  }

  @media (max-width: 640px) {
    h3 {
      font-size: 20px;
    }
  }
</style>
