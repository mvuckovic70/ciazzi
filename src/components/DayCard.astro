---
import type { CollectionEntry } from 'astro:content';
import { CAT_LABELS, formatDate, useTranslation } from '../i18n/translations';
import { astroSlugToUrl } from '../i18n/slugUtils';
import type { Lang } from '../i18n/translations';

interface Props {
  day: CollectionEntry<'days'>;
  lang: Lang;
}

const { day, lang } = Astro.props;
const { data } = day;
const tr = useTranslation(lang);

const title = data.title[lang] ?? data.title['sr'];
const lead = data.lead[lang] ?? data.lead['sr'];
const hasFacts = (data.facts?.[lang] ?? data.facts?.['sr'])?.length;
const hasClaims = (data.claims?.[lang] ?? data.claims?.['sr'])?.length;

const urlSlug = astroSlugToUrl(day.slug);
const dayUrl = lang === 'sr' ? `/dan/${urlSlug}` : `/${lang}/dan/${urlSlug}`;

// Category color map
const CAT_COLORS: Record<string, {bg:string,text:string}> = {
  tragedija: { bg: 'rgba(193,18,31,.18)',   text: '#f3b0b0' },
  pokret:    { bg: 'rgba(239,159,39,.16)',   text: '#f0c178' },
  korupcija: { bg: 'rgba(127,119,221,.18)',  text: '#c5bff2' },
  policija:  { bg: 'rgba(55,138,221,.16)',   text: '#9cc4ef' },
  politika:  { bg: 'rgba(29,158,117,.16)',   text: '#7fd3b6' },
  svet:      { bg: 'rgba(136,135,128,.2)',   text: '#d6d1c6' },
};
---

<a href={dayUrl} class="day-card" data-cats={data.categories.join(',')}>
  <div class="thumb">
    {typeof data.thumbnail.src === 'string' ? (
      <img src={data.thumbnail.src} alt={data.thumbnail.alt[lang] ?? ''} loading="lazy" />
    ) : (
      <img src={data.thumbnail.src.src} alt={data.thumbnail.alt[lang] ?? ''} loading="lazy" />
    )}
    <span class="badge">{tr(`media${data.thumbnail.type.charAt(0).toUpperCase() + data.thumbnail.type.slice(1)}`)}</span>
  </div>

  <div class="body">
    <div class="meta">
      <span class="date">{formatDate(data.date, lang)}</span>
      {data.categories.slice(0, 2).map(cat => {
        const c = CAT_COLORS[cat] ?? CAT_COLORS['svet'];
        return (
          <span class="tag" style={`background:${c.bg};color:${c.text};`}>
            {CAT_LABELS[lang][cat]}
          </span>
        );
      })}
    </div>

    <h3 class="title">{title}</h3>
    <p class="lead-text">{lead}</p>

    <div class="pills">
      {hasFacts  && <span class="tag pill-fact"><i class="ti ti-check" aria-hidden="true"></i>{tr('factLabel').split('—')[0].trim()}</span>}
      {hasClaims && <span class="tag pill-claim"><i class="ti ti-alert-triangle" aria-hidden="true"></i>{tr('claimLabel').split('—')[0].trim()}</span>}
    </div>
  </div>
</a>

<style>
.day-card {
  display: block;
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  cursor: pointer;
  transition: border-color .2s, transform .2s;
  text-decoration: none;
  color: inherit;
}
.day-card:hover {
  border-color: var(--border-strong);
  transform: translateY(-2px);
}
.thumb {
  height: 140px;
  background: var(--surface2);
  position: relative;
  overflow: hidden;
}
.thumb img {
  width: 100%; height: 100%;
  object-fit: cover;
}
.badge {
  position: absolute; top: 8px; left: 8px;
  font-size: 10px; letter-spacing: .5px;
  background: rgba(0,0,0,.65); color: #eee;
  padding: 3px 7px; border-radius: 5px;
}
.body { padding: 13px 15px 16px; }
.meta {
  display: flex; align-items: center;
  gap: 6px; flex-wrap: wrap; margin-bottom: 7px;
}
.date {
  font-size: 11px; color: var(--text-dim);
  font-family: var(--font-mono);
}
.title {
  font-family: var(--font-serif);
  font-size: 16px; color: #f3efe7;
  line-height: 1.3; margin: 0 0 6px;
  font-weight: 700;
}
.lead-text {
  font-size: 13px; color: var(--text-muted);
  margin: 0 0 10px; line-height: 1.5;
}
.pills { display: flex; flex-wrap: wrap; gap: 5px; }
</style>
