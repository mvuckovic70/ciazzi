---
import { LANGS, LANG_LABELS, useTranslation } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ogImage?: string;
  canonicalSlug?: string;
}

const { lang, title, description, ogImage, canonicalSlug } = Astro.props;
const tr = useTranslation(lang);

const base = 'https://ciazzi.com';
const slug = canonicalSlug ?? '';
const currentHref = lang === 'sr' ? `${base}${slug}` : `${base}/${lang}${slug}`;
const metaDesc = description ?? tr('metaDesc');
const ogImg = ogImage ?? `${base}/og-default.jpg`;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - ciazzi</title>
    <meta name="description" content={metaDesc} />

    <link rel="canonical" href={currentHref} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={l === 'sr' ? `${base}${slug}` : `${base}/${l}${slug}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${base}${slug}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} - ciazzi`} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:locale" content={lang === 'sr' ? 'sr_RS' : lang} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,500;6..72,650;6..72,700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css" />

    <style is:global>
      :root {
        --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-serif: Newsreader, Georgia, serif;

        --bg: #f4f0e8;
        --bg-soft: #ebe5da;
        --surface: #fffdf8;
        --surface-raised: #ffffff;
        --surface-muted: #e9e1d4;
        --border: rgba(42, 47, 56, 0.14);
        --border-strong: rgba(42, 47, 56, 0.28);

        --text: #171a20;
        --text-muted: #4c5360;
        --text-dim: #747b86;
        --accent: #c6292d;
        --accent-strong: #a9151d;
        --accent-soft: rgba(198, 41, 45, 0.10);
        --gold: #9b6f16;
        --green: #2f7c5b;
        --blue: #2f679f;

        --fact-bg: rgba(47, 124, 91, 0.10);
        --fact-text: #236346;
        --fact-border: rgba(47, 124, 91, 0.24);
        --claim-bg: rgba(155, 111, 22, 0.12);
        --claim-text: #80560d;
        --claim-border: rgba(155, 111, 22, 0.28);

        --radius-sm: 6px;
        --radius-md: 8px;
        --radius-lg: 10px;
        --max-w: 1160px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--bg); }
      body {
        margin: 0;
        min-height: 100dvh;
        background:
          linear-gradient(180deg, rgba(198,41,45,0.08), transparent 360px),
          linear-gradient(90deg, rgba(255,255,255,0.55), transparent 42%),
          var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.55;
        text-rendering: optimizeLegibility;
      }

      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      button, input { font: inherit; }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .site-shell {
        width: min(100% - 32px, var(--max-w));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid var(--border);
        background: rgba(244, 240, 232, 0.88);
        backdrop-filter: blur(18px);
      }

      .site-nav {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .brand-mark {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(80,30,24,0.16);
        background: linear-gradient(135deg, var(--accent), #8b151c);
        border-radius: var(--radius-sm);
        box-shadow: 0 14px 36px rgba(0,0,0,0.24);
      }

      .brand-mark::after {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: #fffdf8;
      }

      .brand-word {
        font-family: var(--font-serif);
        font-size: 26px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: 0;
      }

      .brand-sub {
        display: block;
        margin-top: 3px;
        color: var(--text-dim);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .lang-nav {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .lang-link {
        min-width: 34px;
        min-height: 30px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-dim);
        font-size: 12px;
        font-weight: 700;
      }

      .lang-link[aria-current="true"] {
        color: var(--text);
        border-color: rgba(212,61,50,0.7);
        background: var(--accent-soft);
      }

      main {
        min-height: calc(100dvh - 180px);
      }

      .tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        min-height: 24px;
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        font-size: 11px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .site-footer {
        border-top: 1px solid var(--border);
        margin-top: 56px;
        color: var(--text-dim);
      }

      .footer-inner {
        min-height: 86px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        font-size: 13px;
      }

      .footer-link {
        color: var(--text-muted);
        border-bottom: 1px solid rgba(198,41,45,0.35);
      }

      @media (max-width: 720px) {
        .site-shell { width: min(100% - 24px, var(--max-w)); }
        .site-nav { min-height: 72px; align-items: flex-start; padding: 12px 0; }
        .brand-sub { display: none; }
        .brand-word { font-size: 24px; }
        .lang-nav { max-width: none; gap: 3px; }
        .lang-link { min-width: 30px; min-height: 28px; font-size: 11px; }
        .footer-inner { align-items: flex-start; flex-direction: column; padding: 24px 0; }
      }
    </style>
  </head>
  <body>
    <a class="sr-only" href="#main">{tr('skipToContent')}</a>
    <header class="site-header">
      <div class="site-shell site-nav">
        <a class="brand" href={lang === 'sr' ? '/' : `/${lang}`} aria-label="ciazzi">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>
            <span class="brand-word">ciazzi</span>
            <span class="brand-sub">{tr('tagline')}</span>
          </span>
        </a>
        <nav class="lang-nav" aria-label="Language selector">
          {LANGS.map((l) => (
            <a
              class="lang-link"
              href={l === 'sr' ? (slug || '/') : `/${l}${slug}`}
              aria-current={l === lang ? 'true' : undefined}
            >
              {LANG_LABELS[l]}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="site-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <span>ciazzi.com · {new Date().getFullYear()}</span>
        <a class="footer-link" href={lang === 'sr' ? '/o-imenu' : `/${lang}/o-imenu`}>
          {tr('aboutName')}
        </a>
      </div>
    </footer>
  </body>
</html>
