---
import { LANGS, LANG_LABELS, useTranslation } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ogImage?: string;
  canonicalSlug?: string; // e.g. "/dan/15-03-2025"
}

const { lang, title, description, ogImage, canonicalSlug } = Astro.props;
const tr = useTranslation(lang);

// Build alternate hreflang URLs
const base = 'https://ciazzi.com';
const slug = canonicalSlug ?? '';
const alternates = LANGS.map((l) => ({
  lang: l,
  href: l === 'sr' ? `${base}${slug}` : `${base}/${l}${slug}`,
}));

const metaDesc = description ?? tr('metaDesc');
const ogImg = ogImage ?? `${base}/og-default.jpg`;
---

<!doctype html>
<html lang={lang} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — ciazzi</title>
  <meta name="description" content={metaDesc} />

  <!-- Canonical + hreflang -->
  <link rel="canonical" href={alternates.find(a => a.lang === lang)?.href} />
  {alternates.map(a => (
    <link rel="alternate" hreflang={a.lang} href={a.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${base}${slug}`} />

  <!-- OG -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} — ciazzi`} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:locale" content={lang === 'sr' ? 'sr_RS' : lang} />

  <!-- Fonts: Playfair Display (serif headlines) + DM Sans (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@400;500&family=DM+Mono:wght@400&display=swap"
    rel="stylesheet"
  />

  <!-- Tabler Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css" />

  <style is:global>
    :root {
      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'DM Sans', system-ui, sans-serif;
      --font-mono: 'DM Mono', monospace;

      --bg: #0f0f12;
      --surface: #161619;
      --surface2: #1a1a1f;
      --border: rgba(255,255,255,.1);
      --border-strong: rgba(255,255,255,.2);

      --text: #e9e4da;
      --text-muted: #b9b3a8;
      --text-dim: #8f897f;
      --text-dimmer: #7d776e;

      --accent: #c1121f;
      --accent-light: rgba(193,18,31,.16);
      --accent-text: #f3b0b0;

      --fact-bg: rgba(125,200,160,.12);
      --fact-text: #9fe0c0;
      --fact-border: rgba(125,200,160,.28);

      --claim-bg: rgba(239,159,39,.12);
      --claim-text: #f0c178;
      --claim-border: rgba(239,159,39,.28);

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;

      --max-w: 1100px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100dvh;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* Accessibility */
    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* Shared utility classes matching the mockup */
    .tag {
      display: inline-flex; align-items: center;
      font-size: 11px; letter-spacing: .3px;
      padding: 2px 8px; border-radius: 4px;
    }
    .pill-fact { background: var(--fact-bg); color: var(--fact-text); }
    .pill-claim { background: var(--claim-bg); color: var(--claim-text); }
  </style>
</head>
<body>
  <a class="sr-only" href="#main">{tr('skipToContent')}</a>

  <!-- Language switcher nav -->
  <header style="display:flex;justify-content:space-between;align-items:center;padding:14px 24px;border-bottom:0.5px solid var(--border);max-width:var(--max-w);margin:0 auto;width:100%;">
    <a href={lang === 'sr' ? '/' : `/${lang}`} style="display:flex;align-items:center;gap:10px;">
      <span style="width:16px;height:16px;background:var(--accent);border-radius:3px;flex-shrink:0;"></span>
      <span style="font-family:var(--font-serif);font-size:20px;color:#fff;letter-spacing:.5px;">ciazzi</span>
    </a>
    <nav aria-label="Language selector" style="display:flex;gap:4px;">
      {LANGS.map((l) => (
        <a
          href={l === 'sr' ? `/${slug}` : `/${l}${slug}`}
          aria-current={l === lang ? 'true' : undefined}
          style={`font-size:12px;padding:4px 8px;border-radius:var(--radius-sm);border:0.5px solid ${
            l === lang ? 'var(--accent)' : 'var(--border)'
          };background:${l === lang ? 'var(--accent-light)' : 'none'};color:${
            l === lang ? '#fff' : 'var(--text-dim)'
          };`}
        >
          {LANG_LABELS[l]}
        </a>
      ))}
    </nav>
  </header>

  <main id="main" style="max-width:var(--max-w);margin:0 auto;padding:0 24px;">
    <slot />
  </main>

  <footer style="margin-top:60px;padding:24px;border-top:0.5px solid var(--border);text-align:center;font-size:12px;color:var(--text-dimmer);">
    ciazzi.com · {new Date().getFullYear()} ·
    <a href={lang === 'sr' ? '/o-imenu' : `/${lang}/o-imenu`} style="color:var(--accent-text);">
      {tr('aboutName')}
    </a>
  </footer>
</body>
</html>
