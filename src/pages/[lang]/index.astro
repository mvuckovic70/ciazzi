---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PublicHome from '../../components/PublicHome.astro';
import { LANGS, useTranslation } from '../../i18n/translations';
import type { Lang } from '../../i18n/translations';

export function getStaticPaths() {
  return LANGS.filter((lang) => lang !== 'sr').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const tr = useTranslation(lang);

const days = (await getCollection('days')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base lang={lang} title={tr('secTitle')} canonicalSlug="">
  <PublicHome lang={lang} days={days} />
</Base>
