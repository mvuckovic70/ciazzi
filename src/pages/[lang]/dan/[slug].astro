---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PublicDay from '../../../components/PublicDay.astro';
import { LANGS } from '../../../i18n/translations';
import { getDayView } from '../../../lib/dayView';
import { astroSlugToUrl } from '../../../i18n/slugUtils';
import type { Lang } from '../../../i18n/translations';

export async function getStaticPaths() {
  const days = await getCollection('days');
  return LANGS.filter((lang) => lang !== 'sr').flatMap((lang) =>
    days.map((day) => ({
      params: { lang, slug: astroSlugToUrl(day.slug) },
      props: { day },
    }))
  );
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { day } = Astro.props;
const { render } = day;
const { Content } = await render();
const view = getDayView(day, lang);
---

<Base lang={lang} title={view.title} description={view.lead} canonicalSlug={view.canonicalSlug} ogImage={view.thumbnail.src}>
  <PublicDay day={day} lang={lang}>
    <Content />
  </PublicDay>
</Base>
