---
// SR is the default locale — no /sr/ prefix, served at root.
// Non-SR routes are handled by /[lang]/index.astro.
// This file just re-exports the SR home page.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DayCard from '../components/DayCard.astro';
import { CAT_LABELS, useTranslation } from '../i18n/translations';

const lang = 'sr' as const;
const tr = useTranslation(lang);

const days = (await getCollection('days')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const start = new Date('2024-11-01').getTime();
const dayCount = Math.round((Date.now() - start) / 86_400_000);

const categories = ['tragedija', 'pokret', 'korupcija', 'policija', 'politika', 'svet'] as const;
---

<Base lang={lang} title={tr('secTitle')} canonicalSlug="">
  <section class="hero">
    <div class="hero-kicker">{tr('heroKicker')}</div>
    <h1 class="hero-title">{tr('heroTitle')}</h1>
    <p class="hero-lead">{tr('heroLead')}</p>
    <div class="stats">
      <div><span class="stat-n red">{dayCount.toLocaleString('sr-RS')}</span><span class="stat-l">{tr('statDays')}</span></div>
      <div><span class="stat-n">16</span><span class="stat-l">{tr('statLives')}</span></div>
      <div><span class="stat-n">6</span><span class="stat-l">{tr('statLangs')}</span></div>
    </div>
    <div class="silence">
      <i class="ti ti-clock" aria-hidden="true"></i>
      <span>{tr('silence')}</span>
    </div>
  </section>

  <div class="sec-header">
    <h2 class="sec-title">{tr('secTitle')}</h2>
    <p class="sec-sub">{tr('secSub')}</p>
  </div>

  <div class="filters" id="filters">
    <button class="chip active" data-cat="all">{tr('fAll')}</button>
    {categories.map(cat => (
      <button class="chip" data-cat={cat}>{CAT_LABELS[lang][cat]}</button>
    ))}
  </div>

  <div class="grid" id="grid">
    {days.map(day => <DayCard day={day} lang={lang} />)}
  </div>
</Base>

<!-- Reuse styles from [lang]/index.astro -->
<style>
.hero { padding: 48px 0 36px; border-bottom: 0.5px solid var(--border); margin-bottom: 32px; }
.hero-kicker { font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#d98a8a;margin-bottom:12px; }
.hero-title { font-family:var(--font-serif);font-size:clamp(24px,4vw,36px);line-height:1.18;color:#fff;margin-bottom:14px; }
.hero-lead { font-size:15px;color:var(--text-muted);max-width:680px;margin-bottom:28px; }
.stats { display:flex;gap:32px;flex-wrap:wrap;margin-bottom:20px; }
.stat-n { display:block;font-family:var(--font-serif);font-size:28px;color:#fff; }
.stat-n.red { color:#e2554f; }
.stat-l { font-size:12px;color:var(--text-dim); }
.silence { display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#cdb0b0;border-left:2px solid var(--accent);padding-left:10px; }
.sec-header { display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:6px;margin-bottom:14px; }
.sec-title { font-family:var(--font-serif);font-size:22px;color:#fff; }
.sec-sub { font-size:13px;color:var(--text-dim); }
.filters { display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px; }
.chip { font-size:12px;color:var(--text-muted);background:var(--surface);border:0.5px solid var(--border);border-radius:20px;padding:5px 14px;cursor:pointer;transition:all .15s; }
.chip.active,.chip:hover { background:#fff;color:#111;border-color:#fff; }
.grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;padding-bottom:48px; }
</style>

<script>
const chips = document.querySelectorAll<HTMLButtonElement>('#filters .chip');
const cards = document.querySelectorAll<HTMLElement>('#grid .day-card');
chips.forEach(chip => {
  chip.addEventListener('click', () => {
    chips.forEach(c => c.classList.remove('active'));
    chip.classList.add('active');
    const cat = chip.dataset.cat!;
    cards.forEach(card => {
      const cats = card.dataset.cats?.split(',') ?? [];
      card.style.display = (cat === 'all' || cats.includes(cat)) ? '' : 'none';
    });
  });
});
</script>
