---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { LANGS, CAT_LABELS, formatDate, useTranslation } from '../../i18n/translations';
import { astroSlugToUrl, urlSlugToAstro } from '../../i18n/slugUtils';
import type { Lang } from '../../i18n/translations';

export async function getStaticPaths() {
  const days = await getCollection('days');
  return days.map(day => ({
    params: { slug: astroSlugToUrl(day.slug) },
    props: { day },
  }));
}

const { slug } = Astro.params as { slug: string };
const lang = 'sr' as const;
const { day } = Astro.props;
const { data, render } = day;
const { Content } = await render();
const tr = useTranslation(lang);

const title    = data.title[lang]  ?? data.title['sr'];
const lead     = data.lead[lang]   ?? data.lead['sr'];
const facts    = data.facts?.[lang]  ?? data.facts?.['sr']  ?? [];
const claims   = data.claims?.[lang] ?? data.claims?.['sr'] ?? [];
const quotes   = data.quotes ?? [];

const homeUrl  = lang === 'sr' ? '/' : `/${lang}`;
const canon    = `/dan/${slug}`; // slug here is already URL format DD-MM-YYYY

// Category color map
const CAT_COLORS: Record<string, string> = {
  tragedija: '#f3b0b0', pokret: '#f0c178', korupcija: '#c5bff2',
  policija:  '#9cc4ef', politika: '#7fd3b6', svet: '#d6d1c6',
};
const CAT_BG: Record<string, string> = {
  tragedija: 'rgba(193,18,31,.18)', pokret: 'rgba(239,159,39,.16)',
  korupcija: 'rgba(127,119,221,.18)', policija: 'rgba(55,138,221,.16)',
  politika:  'rgba(29,158,117,.16)', svet: 'rgba(136,135,128,.2)',
};
---

<Base lang={lang} title={title} description={lead} canonicalSlug={canon}>
  <article class="day-page">

    <!-- Back -->
    <a href={homeUrl} class="back">
      <i class="ti ti-arrow-left" aria-hidden="true"></i>
      {tr('back')}
    </a>

    <!-- Header -->
    <div class="day-kicker">{formatDate(data.date, lang)}</div>
    <h1 class="day-title">{title}</h1>

    <div class="tags">
      {data.categories.map(cat => (
        <span class="tag" style={`background:${CAT_BG[cat]};color:${CAT_COLORS[cat]};`}>
          {CAT_LABELS[lang][cat]}
        </span>
      ))}
    </div>

    <p class="day-lead">{lead}</p>

    <!-- Media gallery (thumbnails; embeds handled below) -->
    {data.media && data.media.length > 0 && (
      <div class="gallery">
        {data.media.slice(0, 6).map(item => (
          <div class="gal-item">
            {item.embedUrl ? (
              <iframe
                src={item.embedUrl}
                title={item.caption?.[lang] ?? ''}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            ) : typeof item.src === 'string' ? (
              <img src={item.src} alt={item.caption?.[lang] ?? ''} loading="lazy" />
            ) : (
              <img src={(item.src as any).src} alt={item.caption?.[lang] ?? ''} loading="lazy" />
            )}
          </div>
        ))}
      </div>
    )}

    <!-- Fact / Claim -->
    {(facts.length > 0 || claims.length > 0) && (
      <div class="two-col">
        {facts.length > 0 && (
          <div class="panel panel-fact">
            <div class="panel-label" style="color:var(--fact-text);">
              <i class="ti ti-check" aria-hidden="true"></i>
              {tr('factLabel')}
            </div>
            <ul>
              {facts.map(f => <li>{f}</li>)}
            </ul>
          </div>
        )}
        {claims.length > 0 && (
          <div class="panel panel-claim">
            <div class="panel-label" style="color:var(--claim-text);">
              <i class="ti ti-alert-triangle" aria-hidden="true"></i>
              {tr('claimLabel')}
            </div>
            <ul>
              {claims.map(c => (
                <li>
                  {c.text}
                  {c.disputed && <span class="note"> — {tr('disputed')}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- Long-form body (MDX) -->
    <div class="prose">
      <Content />
    </div>

    <!-- Quotes -->
    {quotes.map(q => (
      <figure class="quote-block">
        <blockquote>
          {q.text[lang] ?? q.text['sr']}
        </blockquote>
        <figcaption>
          — {q.attribution['sr']}
          {!q.verified && <span class="note">(navod · nije verifikovan)</span>}
        </figcaption>
      </figure>
    ))}

    <!-- Sources -->
    <div class="sources-label">{tr('sourcesLabel')}</div>
    <div class="sources">
      {data.sources.map(src => (
        src.url ? (
          <a href={src.url} target="_blank" rel="noopener noreferrer" class="source-chip">
            {src.label}
            {src.archiveUrl && (
              <a href={src.archiveUrl} target="_blank" rel="noopener noreferrer" class="archive-link" title="Archive">
                <i class="ti ti-archive" aria-hidden="true"></i>
              </a>
            )}
          </a>
        ) : (
          <span class="source-chip">{src.label}</span>
        )
      ))}
    </div>

  </article>
</Base>

<style>
.day-page { padding: 28px 0 48px; }

.back {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 12px; color: var(--text-dim);
  margin-bottom: 20px;
  transition: color .15s;
}
.back:hover { color: var(--text); }

.day-kicker {
  font-size: 12px; letter-spacing: 2px;
  text-transform: uppercase; color: #d98a8a;
  margin-bottom: 10px;
}
.day-title {
  font-family: var(--font-serif);
  font-size: clamp(22px, 4vw, 32px);
  color: #fff; line-height: 1.2;
  margin-bottom: 12px;
}
.tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }

.day-lead {
  font-size: 16px; color: var(--text-muted);
  max-width: 720px; margin-bottom: 24px;
  line-height: 1.65;
}

/* Gallery */
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 8px; margin-bottom: 24px;
}
.gal-item {
  aspect-ratio: 16/9;
  border-radius: var(--radius-md);
  overflow: hidden; background: var(--surface2);
}
.gal-item img, .gal-item iframe {
  width: 100%; height: 100%; object-fit: cover; border: 0;
}

/* Fact / Claim panels */
.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px; margin-bottom: 28px;
}
@media (max-width: 600px) { .two-col { grid-template-columns: 1fr; } }

.panel {
  border-radius: var(--radius-md);
  padding: 14px 16px;
}
.panel-fact  { background: var(--fact-bg);  border: 0.5px solid var(--fact-border); }
.panel-claim { background: var(--claim-bg); border: 0.5px solid var(--claim-border); }

.panel-label {
  font-size: 12px; letter-spacing: .4px;
  margin-bottom: 10px;
  display: flex; align-items: center; gap: 6px;
}
.panel ul { list-style: none; padding: 0; }
.panel li {
  font-size: 13px; color: var(--text-muted);
  margin-bottom: 8px; padding-left: 14px; position: relative;
}
.panel li::before {
  content: ''; position: absolute;
  left: 0; top: 8px;
  width: 5px; height: 5px;
  border-radius: 50%; background: #6f6a61;
}

/* Long-form prose */
.prose {
  max-width: 720px;
  font-size: 15px; color: var(--text-muted);
  line-height: 1.75; margin-bottom: 28px;
}
.prose h2 {
  font-family: var(--font-serif);
  font-size: 22px; color: #fff;
  margin: 32px 0 10px;
}
.prose h3 {
  font-family: var(--font-serif);
  font-size: 18px; color: #f3efe7;
  margin: 24px 0 8px;
}
.prose p { margin-bottom: 16px; }
.prose a { color: var(--accent-text); text-decoration: underline; }
.prose strong { color: var(--text); }

/* Quotes */
.quote-block {
  border-left: 3px solid var(--accent);
  padding: 4px 0 4px 18px;
  margin: 0 0 20px;
}
blockquote {
  font-family: var(--font-serif);
  font-size: 18px; color: #efe9df;
  font-style: italic; line-height: 1.5;
  margin-bottom: 6px;
}
figcaption { font-size: 12px; color: var(--text-dim); }

/* Sources */
.sources-label {
  font-size: 11px; letter-spacing: 1px;
  color: var(--text-dim); margin-bottom: 8px;
}
.sources { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 32px; }
.source-chip {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 12px; color: var(--text-muted);
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 5px 10px;
  transition: border-color .15s;
}
.source-chip:hover { border-color: var(--border-strong); color: var(--text); }
.archive-link { color: var(--text-dimmer); font-size: 11px; }
.note { font-size: 11px; color: var(--text-dimmer); font-style: italic; margin-left: 4px; }
</style>
